    "db:pull": "prisma db pull && prisma generate",
    "db:studio": "prisma studio",
    "push:keys": "node scripts/push-keys.mjs",
    "test:db": "./scripts/test-db.sh",
    "test:prisma": "DATABASE_URL=\"$(./scripts/test-db.sh | tail -1)\" vitest run tests/unit/prisma-rls.test.ts",
    "postinstall": "prisma generate"
  },
